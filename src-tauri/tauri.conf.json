{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TickGold",
  "version": "2.25.5",
  "identifier": "com.stockdock.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "TickGold",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/128x128.png",
      "icons/icon.icns"
    ],
    "resources": {
      "resources/broker/sidecar_qmt.py": "resources/broker/sidecar_qmt.py",
      "resources/plugins/bias-indicator/main.js": "resources/plugins/bias-indicator/main.js",
      "resources/plugins/bias-indicator/plugin.json": "resources/plugins/bias-indicator/plugin.json",
      "resources/plugins/bias-indicator/ui.js": "resources/plugins/bias-indicator/ui.js",
      "resources/plugins/quote-banner/plugin.json": "resources/plugins/quote-banner/plugin.json",
      "resources/plugins/quote-banner/ui.js": "resources/plugins/quote-banner/ui.js"
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5RDUyQTUzQjk1RUE2Q0IKUldUTHBsNjVVeXJWK2Nuc3ZiN1lqQ3pLeW5CNG9hSnZkUmlPYjRWZTJRaVRyZS96N3NVQ0YybXcK",
      "endpoints": [
        "https://ghproxy.net/https://github.com/mhxy881126/tickgold/releases/latest/download/latest.ghproxy.json",
        "https://gh-proxy.com/https://github.com/mhxy881126/tickgold/releases/latest/download/latest.gh-proxy.json",
        "https://github.com/mhxy881126/tickgold/releases/latest/download/latest.json"
      ]
    }
  }
}
