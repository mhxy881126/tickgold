{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TickGold",
  "version": "3.15.0",
  "identifier": "com.stockdock.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https:; object-src 'none'; frame-src 'self'; base-uri 'self'",
      "devCsp": "default-src 'self' http://127.0.0.1:1420; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420 https:; object-src 'none'; frame-src 'self'; base-uri 'self'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/128x128.png",
      "icons/icon.icns"
    ],
    "resources": {
      "resources/broker/sidecar_qmt.py": "resources/broker/sidecar_qmt.py",
      "resources/broker/sidecar_client.py": "resources/broker/sidecar_client.py",
      "resources/plugins/bias-indicator/main.js": "resources/plugins/bias-indicator/main.js",
      "resources/plugins/bias-indicator/plugin.json": "resources/plugins/bias-indicator/plugin.json",
      "resources/plugins/bias-indicator/ui.js": "resources/plugins/bias-indicator/ui.js",
      "resources/plugins/quote-banner/plugin.json": "resources/plugins/quote-banner/plugin.json",
      "resources/plugins/quote-banner/ui.js": "resources/plugins/quote-banner/ui.js",
      "resources/plugins/l2-template/plugin.json": "resources/plugins/l2-template/plugin.json",
      "resources/plugins/l2-template/main.js": "resources/plugins/l2-template/main.js"
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5RDUyQTUzQjk1RUE2Q0IKUldUTHBsNjVVeXJWK2Nuc3ZiN1lqQ3pLeW5CNG9hSnZkUmlPYjRWZTJRaVRyZS96N3NVQ0YybXcK",
      "endpoints": [
        "https://ghproxy.net/https://github.com/mhxy881126/tickgold-public/releases/latest/download/latest.ghproxy.json",
        "https://gh-proxy.com/https://github.com/mhxy881126/tickgold-public/releases/latest/download/latest.gh-proxy.json",
        "https://github.com/mhxy881126/tickgold-public/releases/latest/download/latest.json"
      ]
    }
  }
}